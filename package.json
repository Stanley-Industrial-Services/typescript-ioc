    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.19",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.2",
    "tslint-config-prettier": "^1.18.0",
