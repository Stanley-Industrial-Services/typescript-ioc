    "lint:fix": "tslint --fix ./src/**/*.ts ./test/**/*.ts -t verbose",
    "pretest": "npm run build && npm run lint",
    "test": "jest --config ./test/jest.config.js --coverage",
    "tsc": "tsc"
  },
  "dependencies": {
    "lodash": "4.17.23",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
